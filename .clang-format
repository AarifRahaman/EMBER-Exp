
# Hybrid Modern C++ Style for EMBER
# Compatible with Clang-Format 14
BasedOnStyle: LLVM
Standard: c++20

# --- FMT-001: Indentation and source layout ---
IndentWidth: 4
TabWidth: 4
UseTab: Never
ColumnLimit: 100
ReflowComments: true
MaxEmptyLinesToKeep: 1
SeparateDefinitionBlocks: Always

# LF line endings (Clang-Format 14)
DeriveLineEnding: false
UseCRLF: false

KeepEmptyLinesAtTheStartOfBlocks: false

# --- FMT-002: Braces and control flow ---
BreakBeforeBraces: Custom

BraceWrapping:
  AfterCaseLabel: false
  AfterClass: false
  AfterControlStatement: Never
  AfterEnum: false
  AfterFunction: false
  AfterNamespace: false
  AfterStruct: false
  AfterUnion: false
  BeforeElse: true
  BeforeCatch: true
  BeforeWhile: true

AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortFunctionsOnASingleLine: None
AllowShortBlocksOnASingleLine: Never
AllowShortLambdasOnASingleLine: None

# --- FMT-003: Whitespace ---
SpaceBeforeParens: ControlStatements
SpacesInParentheses: false
SpaceBeforeAssignmentOperators: true
SpaceAfterCStyleCast: false

PointerAlignment: Left
DerivePointerAlignment: false
ReferenceAlignment: Left

# --- FMT-004: Switch and namespaces ---
IndentCaseLabels: true
NamespaceIndentation: None
CompactNamespaces: false
AllowShortCaseLabelsOnASingleLine: false

# --- FMT-005: Constructor initializer lists ---
PackConstructorInitializers: CurrentLine
BreakConstructorInitializers: BeforeColon
ConstructorInitializerIndentWidth: 4

# --- FMT-006: Trailing commas ---
# C++ trailing commas must be maintained manually.
InsertTrailingCommas: None

# --- HDR-003: Header include order ---
SortIncludes: true
IncludeBlocks: Regroup

IncludeCategories:
  # 2. Same-project headers
  - Regex: '^".*"$'
    Priority: 2

  # 3. Third-party headers
  - Regex: '^<.+/.+>$'
    Priority: 3

  # 4. Standard-library headers
  - Regex: '^<[^/]+>$'
    Priority: 4
